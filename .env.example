# Copy to .env and uncomment what you need. Every variable can also be set in the environment.

# Absolute URL of this instance, no trailing slash. Leave empty for root-relative links
# (RSS feeds then use the request's own host).
# APP_URL="http://localhost:8080"

# Show TikTok's raw error responses on error pages ("Show debug info")
# APP_DEBUG=false

# Cache backend: memory (default) | json | redis | none
# API_CACHE=memory
# Seconds a scraped TikTok response stays cached (video URLs expire after some hours)
# CACHE_TTL=3600

# JSON cache directory (API_CACHE=json)
# API_CACHE_JSON=./cache/api

# Redis cache (API_CACHE=redis, needs the "redis" extra: uv sync --extra redis). CHOOSE ONE:
# REDIS_URL=redis://:password@localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=example

# Outbound proxy for all TikTok traffic (HTTP client and Chromium).
# Available: http:// | https:// | socks4:// | socks5://
# PROXY="socks5://user:password@host:port"

# User agent for the plain-HTTP client (page hydration and the media proxy)
# USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"

# Headless Chromium (Playwright) used for signed TikTok API calls
# BROWSER_HEADLESS=true
# BROWSER_TIMEOUT=30
